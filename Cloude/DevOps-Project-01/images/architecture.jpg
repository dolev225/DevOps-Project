<svg xmlns="http://www.w3.org/2000/svg" width="680" height="556" viewBox="0 0 680 556" font-family="Segoe UI, Helvetica, Arial, sans-serif" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata><defs><marker id="a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="#5F5E5A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs><rect width="680" height="556" fill="#ffffff"/><rect x="40" y="64" width="260" height="452" rx="20" fill="#F1EFE8" stroke="#5F5E5A"/><text x="60" y="88" font-size="14" font-weight="600" fill="#2C2C2A">Deploy-EC2/</text><rect x="400" y="64" width="240" height="452" rx="20" fill="#F1EFE8" stroke="#5F5E5A"/><text x="420" y="88" font-size="14" font-weight="600" fill="#2C2C2A">AWS cloud</text><rect x="60" y="100" width="220" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="1"/><text x="170.0" y="122" text-anchor="middle" font-size="14" font-weight="600" fill="#3C3489">providers.tf</text><text x="170.0" y="141" text-anchor="middle" font-size="12" fill="#534AB7">AWS provider, versions</text><rect x="60" y="166" width="220" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="1"/><text x="170.0" y="188" text-anchor="middle" font-size="14" font-weight="600" fill="#3C3489">variables.tf</text><text x="170.0" y="207" text-anchor="middle" font-size="12" fill="#534AB7">Input variables</text><rect x="60" y="232" width="220" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="1"/><text x="170.0" y="254" text-anchor="middle" font-size="14" font-weight="600" fill="#3C3489">terraform.tfvars</text><text x="170.0" y="273" text-anchor="middle" font-size="12" fill="#534AB7">Your values, git-ignored</text><rect x="60" y="298" width="220" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="1"/><text x="170.0" y="320" text-anchor="middle" font-size="14" font-weig